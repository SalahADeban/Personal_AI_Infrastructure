# /etc/config/network
# OpenWrt Network Configuration - VLAN Segmentation
# Router: ASUS RT-AC1200
#
# VLAN Layout:
#   VLAN 1:  Management (10.0.1.0/24)
#   VLAN 10: Trusted LAN (10.0.10.0/24) - LAN1 port
#   VLAN 20: Servers (10.0.20.0/24) - LAN2 port
#   VLAN 30: IoT (10.0.30.0/24) - LAN3 port
#   VLAN 40: Guest (10.0.40.0/24) - WiFi only

config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'

# WAN Interface
config interface 'wan'
    option device 'wan'
    option proto 'dhcp'

config interface 'wan6'
    option device 'wan'
    option proto 'dhcpv6'

# =============================================================================
# VLAN Switch Configuration (for switch-based routers)
# NOTE: Adjust port numbers based on your specific router model
# ASUS RT-AC1200 typically uses: CPU=0, WAN=5, LAN1-4=1-4
# =============================================================================

config device
    option name 'br-lan'
    option type 'bridge'
    list ports 'lan1'
    list ports 'lan2'
    list ports 'lan3'
    list ports 'lan4'

# If your OpenWrt uses swconfig (older style), use this instead:
# config switch
#     option name 'switch0'
